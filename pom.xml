<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>online.yudream.plugins</groupId>
    <artifactId>yudream-admin-plugins</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>YuDream Admin Plugins</name>
    <description>Standalone repository for official YuDream business plugins.</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <yudream.plugin.spi.version>2.6.0</yudream.plugin.spi.version>
        <jackson.version>2.20.0</jackson.version>
        <!-- 插件间 provided 依赖在此统一锁定 provider 版本；消费方禁止用 ${project.version} 与自身版本锁步 -->
        <yudream.plugin.yudream-skin.version>1.1.5</yudream.plugin.yudream-skin.version>
        <yudream.plugin.wallet.version>1.1.1</yudream.plugin.wallet.version>
        <yudream.plugin.minecraft-server.version>1.1.1</yudream.plugin.minecraft-server.version>
        <yudream.plugin.student-info.version>1.1.1</yudream.plugin.student-info.version>
    </properties>

    <modules>
        <module>yudream-plugins/yudream-plugin-alipay</module>
        <module>yudream-plugins/yudream-plugin-authlib-injector</module>
        <module>yudream-plugins/yudream-plugin-minecraft-activity-proof</module>
        <module>yudream-plugins/yudream-plugin-minecraft-server</module>
        <module>yudream-plugins/yudream-plugin-project-progress</module>
        <module>yudream-plugins/yudream-plugin-yudream-skin</module>
        <module>yudream-plugins/yudream-plugin-student-info</module>
        <module>yudream-plugins/yudream-plugin-wallet</module>
        <module>yudream-plugins/yudream-plugin-qq-binding</module>
        <module>yudream-plugins/yudream-plugin-ai-chatbot</module>
        <module>yudream-plugins/yudream-plugin-qqbot-automation</module>
        <module>yudream-plugins/yudream-plugin-codex-task-notify</module>
        <module>yudream-plugins/yudream-plugin-world-map</module>
        <module>yudream-plugins/yudream-plugin-web-card</module>
        <module>yudream-plugins/yudream-plugin-wordle</module>
        <module>yudream-plugins/yudream-plugin-pony</module>
        <module>yudream-plugins/yudream-plugin-mcguess</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>online.yudream.base</groupId>
                <artifactId>yudream-plugin-spi</artifactId>
                <version>${yudream.plugin.spi.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>online.yudream.plugins</groupId>
                <artifactId>yudream-plugin-yudream-skin</artifactId>
                <version>${yudream.plugin.yudream-skin.version}</version>
            </dependency>
            <dependency>
                <groupId>online.yudream.plugins</groupId>
                <artifactId>yudream-plugin-wallet</artifactId>
                <version>${yudream.plugin.wallet.version}</version>
            </dependency>
            <dependency>
                <groupId>online.yudream.plugins</groupId>
                <artifactId>yudream-plugin-minecraft-server</artifactId>
                <version>${yudream.plugin.minecraft-server.version}</version>
            </dependency>
            <dependency>
                <groupId>online.yudream.plugins</groupId>
                <artifactId>yudream-plugin-student-info</artifactId>
                <version>${yudream.plugin.student-info.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!--
          开发模式：把运行时依赖导出到 target/plugin-dev/lib，
          供宿主 yudream.platform.plugin.dev-mode 直接从 target/classes 目录加载插件，
          省去打包 JAR 与拷贝重启。provided 作用域（SPI、插件间 api）由宿主/提供者 ClassLoader 链提供，不会导出。
        -->
        <profile>
            <id>dev-export</id>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.apache.maven.plugins</groupId>
                            <artifactId>maven-dependency-plugin</artifactId>
                            <version>3.8.1</version>
                        </plugin>
                    </plugins>
                </pluginManagement>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>dev-export-libs</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/plugin-dev/lib</outputDirectory>
                                    <includeScope>runtime</includeScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
