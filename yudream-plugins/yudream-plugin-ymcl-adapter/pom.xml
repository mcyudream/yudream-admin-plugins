<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>online.yudream.plugins</groupId>
        <artifactId>yudream-admin-plugins</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>yudream-plugin-ymcl-adapter</artifactId>
    <version>0.8.0</version>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>../../yudream-frontend/packages/plugin-ymcl-adapter/dist</directory>
                <targetPath>META-INF/yudream-plugin/frontend/ymcl-adapter</targetPath>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <excludes>
                                    <exclude>online.yudream.base:yudream-plugin-spi</exclude>
                                </excludes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                                <!-- 皮肤站 API 类被 YmclSkinWardrobeController 的方法签名引用，
                                     注解注册期 getDeclaredMethods 即需可见；未安装 yudream-skin
                                     的宿主必须能从本 JAR 解析这些类型，否则 NCDFE 炸掉整个
                                     onEnable。只收 api 包，服务实现与数据类不打进来。 -->
                                <filter>
                                    <artifact>online.yudream.plugins:yudream-plugin-yudream-skin</artifact>
                                    <includes>
                                        <include>online/yudream/base/plugin/skin/api/**</include>
                                    </includes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>online.yudream.base</groupId>
            <artifactId>yudream-plugin-spi</artifactId>
        </dependency>
        <!-- 皮肤衣柜（YAP §6.11）聚合 yudream-skin 的 SPI：服务实例运行时由宿主注入，
             皮肤站未安装时端点降级 501；但 api 类型出现在 Controller 方法签名上，
             必须随本 JAR 打包（shade 只收 skin/api 包），否则注册期 NCDFE。 -->
        <dependency>
            <groupId>online.yudream.plugins</groupId>
            <artifactId>yudream-plugin-yudream-skin</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
