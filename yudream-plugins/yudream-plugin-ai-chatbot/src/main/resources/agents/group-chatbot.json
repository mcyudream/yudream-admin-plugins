{
  "nodes": [
    {
      "id": "start",
      "type": "agent",
      "position": { "x": 60, "y": 260 },
      "data": { "kind": "start", "title": "接收群消息", "outputVariable": "query" }
    },
    {
      "id": "intent",
      "type": "agent",
      "position": { "x": 320, "y": 260 },
      "data": {
        "kind": "understand",
        "title": "分析意图与安全性",
        "providerCode": "runtime",
        "modelCode": "default",
        "allowModelOverride": true,
        "strictJson": false,
        "prompt": "分析群聊消息，仅输出 JSON：{\"route\":\"refuse|help|tool|chat\",\"topic\":\"主题\",\"style\":\"回复风格\",\"reason\":\"分流原因\",\"query\":\"用于知识库检索或回答的问题重述\",\"graphExpansion\":true|false}。仅当请求明显危险、越权或要求泄露敏感信息时 route=refuse；当请求需要调用工具获取实时/动态数据或执行操作时 route=tool，例如服务器状态、在线人数、玩家或 QQ 号对应的状态与历史记录查询、执行插件指令等；当用户在求助，或询问教程、文档、操作步骤、排错方法及你不确定的项目事实时 route=help，且此时 graphExpansion 输出 true；其余闲聊、讨论 route=chat。",
        "inputVariable": "query",
        "outputVariable": "intent"
      }
    },
    {
      "id": "route-safety",
      "type": "agent",
      "position": { "x": 600, "y": 260 },
      "data": {
        "kind": "condition",
        "title": "是否安全回复",
        "condition": "intent.route == 'refuse'",
        "inputVariable": "intent",
        "outputVariable": "refused"
      }
    },
    {
      "id": "refusal",
      "type": "agent",
      "position": { "x": 860, "y": 60 },
      "data": {
        "kind": "template",
        "title": "生成安全拒答",
        "template": "这个请求我不能直接执行。原因：{{intent.reason}}。可以换一个不涉及敏感信息或越权操作的问题。",
        "inputVariable": "intent",
        "outputVariable": "answer"
      }
    },
    {
      "id": "route-help",
      "type": "agent",
      "position": { "x": 860, "y": 300 },
      "data": {
        "kind": "condition",
        "title": "是否求助检索",
        "condition": "intent.route == 'help'",
        "inputVariable": "intent",
        "outputVariable": "help"
      }
    },
    {
      "id": "wiki-search",
      "type": "agent",
      "position": { "x": 1120, "y": 160 },
      "data": {
        "kind": "tool",
        "title": "检索 Wiki 知识库",
        "toolCode": "wiki.search",
        "inputVariable": "intent",
        "outputVariable": "wikiResult"
      }
    },
    {
      "id": "help-reply",
      "type": "agent",
      "position": { "x": 1400, "y": 160 },
      "data": {
        "kind": "llm",
        "title": "生成图文教程回复",
        "providerCode": "runtime",
        "modelCode": "default",
        "allowModelOverride": true,
        "toolMode": "NONE",
        "prompt": "输入为知识库检索结果 JSON（hits 含 title、spaceName、content、images）。结合用户最新消息作答：有命中时给出步骤清晰、可直接照做的教程式回答，并注明来源页面标题与所属知识库名称；无命中或结果不相关时正常回答，并如实说明未检索到资料。不要输出图片链接或 Markdown 图片语法，相关配图会由系统直接发送到群里。",
        "inputVariable": "wikiResult",
        "outputVariable": "answer"
      }
    },
    {
      "id": "route-tool",
      "type": "agent",
      "position": { "x": 1120, "y": 320 },
      "data": {
        "kind": "condition",
        "title": "是否工具查询",
        "condition": "intent.route == 'tool'",
        "inputVariable": "intent",
        "outputVariable": "tool"
      }
    },
    {
      "id": "tool-task",
      "type": "agent",
      "position": { "x": 1400, "y": 320 },
      "data": {
        "kind": "template",
        "title": "组织工具查询任务",
        "template": "用户消息：{{query}}\n该请求需要实时数据，请调用合适的已授权工具（如服务器状态、玩家/QQ 状态与历史等）获取数据后回答。",
        "inputVariable": "query",
        "outputVariable": "toolTask"
      }
    },
    {
      "id": "tool-reply",
      "type": "agent",
      "position": { "x": 1660, "y": 320 },
      "data": {
        "kind": "llm",
        "title": "调用工具并回复",
        "providerCode": "runtime",
        "modelCode": "default",
        "allowModelOverride": true,
        "toolMode": "AUTO",
        "prompt": "用户的问题需要实时数据，必须优先调用已授权工具获取，禁止凭记忆编造状态、人数或记录。拿到工具结果后如实汇总作答；没有可用工具或工具报错时，如实说明无法查询，不要输出工具参数或 JSON。",
        "inputVariable": "toolTask",
        "outputVariable": "answer"
      }
    },
    {
      "id": "chat-task",
      "type": "agent",
      "position": { "x": 1400, "y": 480 },
      "data": {
        "kind": "template",
        "title": "组织回复任务",
        "template": "群聊主题：{{intent.topic}}\n建议风格：{{intent.style}}\n用户消息：{{query}}\n请结合运行时人设和历史上下文回复；需要时调用已授权插件工具。",
        "inputVariable": "intent",
        "outputVariable": "chatTask"
      }
    },
    {
      "id": "chat-reply",
      "type": "agent",
      "position": { "x": 1400, "y": 440 },
      "data": {
        "kind": "llm",
        "title": "生成群聊回复",
        "providerCode": "runtime",
        "modelCode": "default",
        "allowModelOverride": true,
        "prompt": "直接给出适合发送到群聊的最终回复，不要解释编排过程。",
        "inputVariable": "chatTask",
        "outputVariable": "answer"
      }
    },
    {
      "id": "end",
      "type": "agent",
      "position": { "x": 1700, "y": 260 },
      "data": { "kind": "end", "title": "输出群消息", "inputVariable": "answer" }
    }
  ],
  "edges": [
    { "id": "start-intent", "source": "start", "target": "intent" },
    { "id": "intent-route-safety", "source": "intent", "target": "route-safety" },
    { "id": "route-safety-refusal", "source": "route-safety", "target": "refusal", "sourceHandle": "true" },
    { "id": "route-safety-route-help", "source": "route-safety", "target": "route-help", "sourceHandle": "false" },
    { "id": "refusal-end", "source": "refusal", "target": "end" },
    { "id": "route-help-wiki", "source": "route-help", "target": "wiki-search", "sourceHandle": "true" },
    { "id": "route-help-route-tool", "source": "route-help", "target": "route-tool", "sourceHandle": "false" },
    { "id": "route-tool-task", "source": "route-tool", "target": "tool-task", "sourceHandle": "true" },
    { "id": "route-tool-chat", "source": "route-tool", "target": "chat-task", "sourceHandle": "false" },
    { "id": "tool-task-reply", "source": "tool-task", "target": "tool-reply" },
    { "id": "tool-reply-end", "source": "tool-reply", "target": "end" },
    { "id": "wiki-help-reply", "source": "wiki-search", "target": "help-reply" },
    { "id": "chat-task-reply", "source": "chat-task", "target": "chat-reply" },
    { "id": "help-reply-end", "source": "help-reply", "target": "end" },
    { "id": "chat-reply-end", "source": "chat-reply", "target": "end" }
  ]
}
